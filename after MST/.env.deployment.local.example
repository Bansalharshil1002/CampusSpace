# Copy this file to .env.deployment.local in the project root.
# .env.deployment.local is gitignored. Never commit real credentials.

# Cloudflare API token with Workers Scripts:Edit and Account Settings:Read.
CLOUDFLARE_API_TOKEN=replace-with-your-token

# Cloudflare account ID, found on the Workers & Pages overview page.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id

# Optional: Render API key, if you want to drive Render from this machine.
# RENDER_API_KEY=replace-with-your-render-api-key
