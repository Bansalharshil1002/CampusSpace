# Frontend build-time configuration for the controlled backend demo.
VITE_API_URL=https://your-backend-url.onrender.com
VITE_AUTH_MODE=password
VITE_ALLOW_EMAIL_AUTH=false
VITE_ALLOW_REGISTRATION=false
VITE_SHOW_LOCAL_DEMO=true
VITE_DEPLOYMENT_MODE=controlled-demo
VITE_DEPLOY_NOTICE=Controlled demo — real accounts use a shared hosted database. Local demo roles stay in this browser.
RST_WORKER_NAME=room-status-tracker
