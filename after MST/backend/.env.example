# Copy to .env. SQLite is enough for local work; use PostgreSQL in deployment.
DATABASE_URL=sqlite:///./room_status.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/room_status

ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
ALLOWED_EMAIL_DOMAIN=thapar.edu
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# console = print OTP / magic links in the backend terminal (local development)
# resend  = send real email (set RESEND_API_KEY)
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=Room Status Tracker <noreply@thapar.edu>

# Development defaults. Controlled deployment sets registration/email/dev auth to false.
ALLOW_PUBLIC_REGISTRATION=true
ALLOW_EMAIL_AUTH=true
ALLOW_PASSWORD_RESET=true
ALLOW_DEV_AUTH=true
AUTH_RATE_LIMIT_PER_MINUTE=20

# Create student / CR / society / teacher / DoAA accounts on first start
SEED_DEMO_USERS=true
