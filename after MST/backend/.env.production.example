# Controlled backend demo — production values
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/room_status
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_EXPIRE_MINUTES=10080
ALLOWED_EMAIL_DOMAIN=thapar.edu

# Set these to the deployed frontend origin, comma-separated for CORS.
FRONTEND_URL=https://your-frontend.workers.dev
CORS_ORIGINS=https://your-frontend.workers.dev

# Controlled demo: password-only sign-in, no public signup or email sign-in.
# Password reset is independent of email sign-in and uses Resend for codes.
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_EMAIL_AUTH=false
ALLOW_PASSWORD_RESET=true
ALLOW_DEV_AUTH=false
EMAIL_BACKEND=resend
RESEND_API_KEY=replace-with-your-resend-key
EMAIL_FROM=Room Status Tracker <no-reply@your-verified-domain.com>
SEED_DEMO_USERS=false
AUTH_RATE_LIMIT_PER_MINUTE=20
